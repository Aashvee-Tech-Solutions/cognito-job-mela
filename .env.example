# Google Apps Script URL (for storing form data in Google Sheets)
# Follow the steps in README.md to get this URL from Google Apps Script.
# Prefix VITE_ is required so Vite exposes it to the frontend.
VITE_SCRIPT_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# Google Drive API (for uploading resume files)
# Create a Google Cloud Project, enable Drive API, and create a service account
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key

# Google Drive Folder ID where resumes will be uploaded
# Share a Google Drive folder with your service account and get its ID
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
